{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://barelysmash.dev/schemas/insight/1.0.0/insight.schema.json",
  "title": "Insight",
  "description": "The interpretation connecting Observations to a Decision. Specified in architecture/insight-object.md. See adr/0004-insight-as-a-contract.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "insight_id",
    "source",
    "source_version",
    "domain",
    "statement",
    "confidence",
    "evidence",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "description": "Semver of the Insight specification this object conforms to.",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "insight_id": {
      "description": "Globally unique identifier. 'ins_' followed by a 26-character ULID.",
      "type": "string",
      "pattern": "^ins_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "source": {
      "description": "The engine that produced this Insight. JARVIS is never a source.",
      "type": "string",
      "enum": ["atlas", "friday"]
    },
    "source_version": {
      "description": "Semver of the engine build. Required for reproducibility.",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "domain": {
      "description": "Subdomain that reasoned about this. An Insight has no category.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 64
    },
    "statement": {
      "description": "The interpretation. One declarative sentence, not imperative.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "confidence": {
      "description": "Probability the interpretation holds. No emission floor, unlike a Decision.",
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "method": {
      "description": "How the interpretation was reached, e.g. trend_extrapolation.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 64
    },
    "evidence": {
      "description": "Observations supporting the interpretation. An Insight with none is a belief.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceItem" }
    },
    "supersedes": {
      "description": "The insight_id this Insight replaces. Must share source and domain.",
      "type": "string",
      "pattern": "^ins_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 32 }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "expires_at": {
      "description": "When the interpretation should no longer be relied on. Must exceed created_at.",
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "statement"],
      "properties": {
        "observation_id": {
          "type": "string",
          "pattern": "^obs_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "statement": { "type": "string", "minLength": 1, "maxLength": 280 },
        "metric": { "$ref": "#/$defs/metric" },
        "source_ref": { "type": "string", "maxLength": 512 }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64 },
        "value": { "type": "number" },
        "unit": { "type": "string", "maxLength": 32 },
        "delta": { "type": "number" },
        "period": {
          "type": "string",
          "pattern": "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$"
        }
      }
    }
  }
}
